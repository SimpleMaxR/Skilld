# SkillVault Production Environment Configuration
# Copy to /etc/skillvault/skillvault.env (chmod 0600)

HOST=0.0.0.0
PORT=3737
DATA_DIR=/var/lib/skillvault

# Strong bearer secret; if omitted, skillvault-server generates one in ${DATA_DIR}/token
SKILLVAULT_TOKEN=sv_replace_with_openssl_rand_hex_24

# ReadDB concurrent read-only pool size (clamped between 4 and 6)
DB_READ_CONNS=6

# Optional: GitHub token for higher API rate limits and private skill repos
# GITHUB_TOKEN=ghp_xxx
UPSTREAM_CHECK_INTERVAL_MIN=60
