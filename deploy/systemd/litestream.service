[Unit]
Description=Litestream SQLite Continuous WAL Replication for Skilld (Optional DR)
After=network-online.target skilld-server.service
Wants=network-online.target

[Service]
Type=simple
User=skilld
Group=skilld
EnvironmentFile=-/etc/skilld/litestream.env
ExecStart=/usr/local/bin/litestream replicate -config /etc/skilld/litestream.yml
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skilld

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skilld-litestream

[Install]
WantedBy=multi-user.target
