[Unit]
Description=Skilld Native Go + SQLite High-Concurrency Control Plane
Documentation=https://github.com/SimpleMaxR/Skilld
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skilld
Group=skilld
WorkingDirectory=/var/lib/skilld
EnvironmentFile=-/etc/skilld/skilld.env
ExecStart=/usr/local/bin/skilld-server
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skilld

StandardOutput=journal
StandardError=journal
SyslogIdentifier=skilld-server

[Install]
WantedBy=multi-user.target
