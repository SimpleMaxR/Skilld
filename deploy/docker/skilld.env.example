# Copy this file to the repository root as `.env` before `docker compose up`.
# Compose reads that file for ${...} substitution. `.env` is gitignored.
#
# These names are the same ones the binary and systemd unit read.
# HOST, PORT, and DATA_DIR are set by docker-compose.yml inside the container.
# Change SKILLD_PUBLISH_PORT to choose the port on the host.

SKILLD_PUBLISH_PORT=3737

# Leave empty to generate a token on first start and store it in the data volume
# at /var/lib/skilld/token. The server also prints it to its logs.
SKILLD_TOKEN=

DB_READ_CONNS=6

# Minutes between GitHub upstream checks. 0 disables the background poller.
UPSTREAM_CHECK_INTERVAL_MIN=0

# Optional. Raises GitHub API limits and allows private skill repositories.
# GITHUB_TOKEN=
